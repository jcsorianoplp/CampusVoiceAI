<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Campus Voice AI | Suggestions Inbox</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
	<link rel="stylesheet" href="../../CSS/Admin/suggestion.css" />
</head>
<body class="admin-dashboard-page">
	<main class="admin-dashboard-shell">
		<aside class="admin-sidebar">
			<div class="admin-brand">
				<div class="admin-brand-mark" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<path d="M6.5 16.2c-1.2-1.2-1.9-2.8-1.9-4.5 0-4.1 3.5-7.5 7.8-7.5s7.8 3.4 7.8 7.5-3.5 7.5-7.8 7.5c-.8 0-1.6-.1-2.3-.3L6 20.1l.5-3.9Z" />
					</svg>
				</div>
				<div>
					<div class="admin-brand-name">Campus Voice</div>
					<div class="admin-brand-sub">Organization Control Center</div>
				</div>
			</div>

			<nav class="admin-nav" aria-label="Admin navigation">
				<a class="admin-nav-item" href="./AdminDashboard.html"><i class="bi bi-speedometer2" aria-hidden="true"></i>Dashboard</a>
				<a class="admin-nav-item is-active" href="./AdminSuggestion.html"><i class="bi bi-chat-dots" aria-hidden="true"></i>Suggestions</a>
				<a class="admin-nav-item" href="./AdminPublicStat.html"><i class="bi bi-bar-chart-line" aria-hidden="true"></i>Public Stats</a>
				<a class="admin-nav-item" href="./AdminAICategories.html"><i class="bi bi-diagram-3" aria-hidden="true"></i>AI Categories</a>
				<a class="admin-nav-item" href="./AdminReports.html"><i class="bi bi-file-earmark-text" aria-hidden="true"></i>Reports</a>
			</nav>

			<div class="admin-sidebar-card">
				<div class="admin-sidebar-card-label">Active Organization</div>
				<div class="admin-sidebar-card-value" id="suggestionOrganizationName">Loading...</div>
				<div class="admin-sidebar-card-note" id="suggestionOrganizationRole">Campus Voice AI</div>
			</div>
		</aside>

		<section class="admin-main">
			<header class="admin-topbar">
				<div>
					<div class="admin-kicker">Private Admin Dashboard</div>
					<h1 class="admin-title">Suggestions Inbox</h1>
				</div>
				<div class="admin-topbar-actions">
					<button class="admin-bell-btn" type="button" aria-label="Notifications">
						<i class="bi bi-bell-fill" aria-hidden="true"></i>
					</button>
					<div class="admin-profile-menu" data-admin-profile-menu>
						<button class="admin-profile-trigger" type="button" aria-label="Profile menu" data-admin-profile-trigger>
							<i class="bi bi-person-fill" aria-hidden="true"></i>
						</button>
						<div class="admin-profile-dropdown" role="menu" aria-label="Profile options">
							<button class="admin-profile-item" type="button" role="menuitem" data-profile-action="profile"><i class="bi bi-person-circle" aria-hidden="true"></i>Profile</button>
							<button class="admin-profile-item" type="button" role="menuitem" data-profile-action="settings"><i class="bi bi-gear" aria-hidden="true"></i>Settings</button>
							<button class="admin-profile-item admin-profile-item--logout" type="button" role="menuitem"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Log out</button>
						</div>
					</div>
				</div>
			</header>

			<section class="admin-panel is-active" data-admin-panel="suggestions">
				<section class="admin-inbox-header">
					<div>
						<div class="admin-panel-label">Suggestions Inbox</div>
						<h2>All student suggestions in one place</h2>
						<p>Search, filter, and review anonymous submissions from the active organization link.</p>
					</div>
					<div class="admin-inbox-meta">
						<span class="admin-meta-pill" id="suggestionTotalCount">0 total</span>
						<span class="admin-meta-pill" id="suggestionOpenCount">0 open</span>
						<span class="admin-meta-pill" id="suggestionResolvedCount">0 resolved</span>
					</div>
				</section>

				<section class="admin-inbox-toolbar">
					<div class="admin-search-shell">
						<span class="admin-search-icon" aria-hidden="true">⌕</span>
						<input class="admin-search" id="suggestionSearch" type="search" placeholder="Search suggestions, categories, or keywords" />
					</div>
					<div class="admin-toolbar-actions">
						<select class="admin-filter" id="categoryFilter" aria-label="Filter by category">
							<option value="all">All Categories</option>
						</select>
						<select class="admin-filter" id="statusFilter" aria-label="Filter by status">
							<option value="all">All Statuses</option>
							<option value="open">Open</option>
							<option value="progress">In Progress</option>
							<option value="resolved">Resolved</option>
						</select>
						<select class="admin-filter" id="sentimentFilter" aria-label="Filter by sentiment">
							<option value="all">All Sentiments</option>
							<option value="neutral">Neutral</option>
							<option value="positive">Positive</option>
							<option value="negative">Negative</option>
						</select>
						<!-- NEW: AI Confidence Filter -->
						<select class="admin-filter" id="lowConfidenceFilter" aria-label="Filter by AI confidence">
							<option value="all">All Confidence</option>
							<option value="low-only">⚠️ Low Confidence (Needs Review)</option>
							<option value="high-only">✓ High Confidence (Auto-routed)</option>
						</select>
						<div class="admin-view-toggle" role="group" aria-label="View mode">
							<button class="view-toggle-btn is-active" type="button" data-view-mode="list" aria-label="List view" title="List view">
								<i class="bi bi-list-ul" aria-hidden="true"></i>
							</button>
							<button class="view-toggle-btn" type="button" data-view-mode="grid" aria-label="Grid view" title="Grid view">
								<i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
							</button>
						</div>
					</div>
				</section>

				<section class="admin-inbox-board is-list" id="suggestionBoard" aria-label="Suggestion inbox">
					<div class="admin-empty-state" id="suggestionEmptyState" hidden>
						No suggestions yet. New submissions will appear here.
					</div>
				</section>
			</section>
		</section>
	</main>

	<script src="../../JS/Admin/adminAuth.js"></script>
	<script src="../../JS/Admin/adminTopbarMenu.js"></script>
	<script src="../../JS/Admin/adminAccountModal.js"></script>
	<script src="../../JS/Admin/adminNav.js"></script>
	<script src="../../JS/Admin/adminState.js"></script>
	<script src="../../JS/Admin/adminSuggestion.js"></script>
</body>
</html>